#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_oid" in
        0000000000000000000000000000000000000000)
            revisions=$(git rev-list "$local_oid" --not --remotes) ;;
        *) revisions=$(git rev-list "$remote_oid..$local_oid") ;;
    esac
    for revision in $revisions; do
        python scripts/check_repo_secrets.py --commit "$revision" || exit 1
    done
done
